---
import '../styles/global.css';
import { site, nav as baseNav } from '../data/site.js';
import { beforeAfter } from '../data/content.js';
// 전후 사례가 있을 때만 메뉴에 '관리 사례' 표시
const nav = beforeAfter.some((c) => c.consent === true)
  ? [...baseNav.slice(0, 2), { label: '관리 사례', href: '/#cases' }, ...baseNav.slice(2)]
  : baseNav;

const {
  title,
  description,
  noindex = false,
  schema = [],
  ogImage = '/images/celljet-main.webp',
} = Astro.props;

const fullTitle = title ? `${title} | 더셀젯 THE CELLJET` : '더셀젯 THE CELLJET | 바늘 없는 앰플 전달 미용기기';
const canonical = new URL(Astro.url.pathname === '/index' ? '/' : Astro.url.pathname, site.url).href;

const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: '더셀젯 (THE CELLJET)',
  alternateName: ['THE CELLJET', 'SUMI THE CELLJET', '더셀젯'],
  url: site.url,
  logo: new URL('/sumi-logo.svg', site.url).href,
  telephone: site.phone,
  ...(site.email ? { email: site.email } : {}),
  address: {
    '@type': 'PostalAddress',
    streetAddress: '둔촌대로80번길 3-10, 212호',
    addressLocality: '성남시 중원구',
    addressRegion: '경기도',
    addressCountry: 'KR',
  },
  ...(site.company ? { legalName: site.company } : {}),
};
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <script is:inline>document.documentElement.classList.add('js');</script>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
  <meta name="naver-site-verification" content={site.naverVerification} />
  <meta name="google-site-verification" content={site.googleVerification} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="더셀젯 THE CELLJET" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(ogImage, site.url).href} />
  <meta property="og:locale" content="ko_KR" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#006a61" />
  <link rel="icon" href="/sumi-logo.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" />
  <script type="application/ld+json" set:html={JSON.stringify(org)} />
  {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
</head>
<body>
  <div class="topbar">
    <div class="wrap topbar-in">
      <span><b>KC 적합등록</b> 전문가용 니들프리 앰플 전달 미용기기</span>
      <a href={`tel:${site.phone}`}>도입 상담 {site.phone}</a>
    </div>
  </div>
  <header class="hd">
    <div class="wrap hd-in">
      <a href="/" class="logo" aria-label="더셀젯 홈">
        <img src="/sumi-logo.svg" alt="SUMI" width="78" height="44" />
        <span class="logo-text">THE CELLJET</span>
      </a>
      <nav class="gnb" id="gnb" aria-label="주요 메뉴">
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
        <a href="/#contact" class="btn btn-primary gnb-cta">시연 · 도입 상담</a>
      </nav>
      <button class="menu-btn" aria-label="메뉴 열기" aria-controls="gnb" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="ft">
    <div class="wrap ft-in">
      <div>
        <div class="ft-logo">
          <img src="/sumi-logo-white.svg" alt="SUMI" width="70" height="40" />
          <span>THE CELLJET</span>
        </div>
        <p class="ft-desc">바늘 없이 앰플을 전달하는 전문가용 미용기기, 더셀젯.<br />본 제품은 미용 목적의 기기이며, 질병의 진단·치료를 위한 의료기기가 아닙니다.</p>
      </div>
      <div class="ft-info">
        {site.company && <p>상호 {site.company}{site.ceo && <> · 대표 {site.ceo}</>}</p>}
        {site.bizNumber && <p>사업자등록번호 {site.bizNumber}</p>}
        <p>{site.address}</p>
        <p>전화 <a href={`tel:${site.phone}`}>{site.phone}</a>{site.email && <> · 이메일 <a href={`mailto:${site.email}`}>{site.email}</a></>}</p>
        <p>제조 {site.manufacturer}</p>
        <p class="ft-links"><a href="/privacy">개인정보처리방침</a></p>
        <p class="copy">© {new Date().getFullYear()} THE CELLJET. All rights reserved.</p>
      </div>
    </div>
  </footer>

  <div class="mbar" aria-label="빠른 연락">
    <a href={`tel:${site.phone}`} class="btn btn-ghost">전화 상담</a>
    <a href="/#contact" class="btn btn-primary">시연 · 도입 상담</a>
  </div>

  <script>
    const btn = document.querySelector('.menu-btn');
    const gnb = document.getElementById('gnb');
    btn?.addEventListener('click', () => {
      const open = gnb!.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(open));
    });
    gnb?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => gnb.classList.remove('open')));

    // 스크롤하면 상단 메뉴를 얇게
    const hd = document.querySelector('.hd');
    const onScroll = () => hd?.classList.toggle('scrolled', scrollY > 40);
    addEventListener('scroll', onScroll, { passive: true }); onScroll();

    // 화면에 들어오는 요소 부드럽게 등장
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' });
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

    // 지금 보고 있는 섹션의 메뉴 강조
    const links = [...document.querySelectorAll<HTMLAnchorElement>('.gnb a[href^="/#"]')];
    const so = new IntersectionObserver((es) => es.forEach((e) => {
      if (!e.isIntersecting) return;
      links.forEach((a) => a.classList.toggle('on', a.hash === '#' + e.target.id));
    }), { rootMargin: '-45% 0px -50% 0px' });
    links.forEach((a) => { const s = document.getElementById(a.hash.slice(1)); if (s) so.observe(s); });
  </script>
</body>
</html>

<style>
  .topbar { background: #004b44; color: #9ff5ea; font-size: 13px; }
  .topbar-in { display: flex; justify-content: space-between; align-items: center; height: 36px; gap: 12px; }
  .topbar b { background: var(--accent); color: #00201d; padding: 2px 7px; border-radius: 5px; font-size: 11px; margin-right: 6px; }
  .topbar a { color: #fff; text-decoration: none; font-weight: 700; }

  .hd { position: sticky; top: 0; z-index: 50; background: rgba(255,255,255,.94); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); }
  .hd-in { display: flex; align-items: center; height: 74px; gap: 20px; transition: height .25s; }
  .hd.scrolled { box-shadow: 0 6px 20px rgba(15,23,42,.07); }
  .hd.scrolled .hd-in { height: 62px; }
  .logo { display: flex; align-items: center; gap: 10px; text-decoration: none; color: var(--ink); }
  .logo img { height: 40px; width: auto; }
  .logo-text { font: 800 15px/1 var(--font-latin); letter-spacing: .08em; color: var(--brand); }
  .gnb { margin-left: auto; display: flex; align-items: center; gap: 2px; }
  .gnb a:not(.btn) { padding: 8px 12px; border-radius: 8px; color: var(--ink-2); font-weight: 700; font-size: 15px; text-decoration: none; }
  .gnb a:not(.btn):hover, .gnb a.on { color: var(--brand); background: var(--brand-soft); }
  .gnb-cta { margin-left: 10px; padding: 11px 18px; font-size: 15px; }
  .menu-btn { display: none; margin-left: auto; width: 44px; height: 44px; border: 0; background: none; cursor: pointer; padding: 10px; }
  .menu-btn span { display: block; height: 2px; background: var(--ink); margin: 5px 0; border-radius: 2px; }

  .ft { background: var(--navy); color: #cbd5e1; padding: 56px 0 120px; font-size: 14.5px; }
  .ft-in { display: grid; grid-template-columns: 1.2fr 1fr; gap: 40px; }
  .ft-logo { display: flex; align-items: center; gap: 10px; color: #fff; font: 800 15px var(--font-latin); letter-spacing: .08em; }
  .ft-logo img { height: 36px; width: auto; }
  .ft-desc { margin-top: 14px; color: #94a3b8; }
  .ft-info { display: grid; gap: 4px; }
  .ft a { color: #e2e8f0; }
  .copy { margin-top: 10px; color: #64748b; }

  .mbar { display: none; }

  @media (max-width: 1080px) {
    .menu-btn { display: block; }
    .gnb { display: none; position: absolute; top: 74px; left: 0; right: 0; flex-direction: column; align-items: stretch; background: #fff; border-bottom: 1px solid var(--line); padding: 12px 20px 20px; gap: 4px; box-shadow: var(--shadow); }
    .gnb.open { display: flex; }
    .gnb a:not(.btn) { padding: 12px; font-size: 16px; }
    .gnb-cta { margin: 8px 0 0; }
  }
  @media (max-width: 900px) {
    .topbar span { display: none; }
    .topbar-in { justify-content: center; }
    .ft-in { grid-template-columns: 1fr; }
    .mbar { display: grid; grid-template-columns: 1fr 1.4fr; gap: 8px; position: fixed; left: 0; right: 0; bottom: 0; z-index: 60; padding: 10px 12px calc(10px + env(safe-area-inset-bottom)); background: rgba(255,255,255,.96); border-top: 1px solid var(--line); }
    .mbar .btn { padding: 13px 10px; }
  }
</style>
