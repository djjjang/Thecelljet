---
import '@fontsource/plus-jakarta-sans/600.css';
import '@fontsource/plus-jakarta-sans/700.css';
import '@fontsource/plus-jakarta-sans/800.css';
import '../styles/global.css';
import { site } from '../data/site.js';
import { beforeAfter } from '../data/content.js';
import { getT, langs, prefix, dicts } from '../i18n/index.js';
import FloatingContact from '../components/FloatingContact.astro';

const {
  title,
  description,
  noindex = false,
  schema = [],
  ogImage = '/images/og-celljet.jpg',
  lang = 'ko',
  path = '/', // 언어 앞부분을 뺀 주소 (예: '/', '/privacy')
} = Astro.props;
const t = getT(lang);
const p = prefix(lang);
const home = p || '/';
const pathFor = (l) => (prefix(l) + (path === '/' ? '' : path)) || '/';
const urlFor = (l) => new URL(pathFor(l), site.url).href;

// 전후 사례가 있을 때만 메뉴에 '관리 사례' 표시
const baseNav = t.nav.map((n) => ({ label: n.label, href: `${p}/#${n.hash}` }));
const nav = beforeAfter.some((c) => c.consent === true)
  ? [...baseNav.slice(0, 2), { label: t.navCases, href: `${p}/#cases` }, ...baseNav.slice(2)]
  : baseNav;

const fullTitle = title ? `${title}${t.meta.titleSuffix}` : t.meta.defaultTitle;
const canonical = urlFor(lang);
const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: t.meta.orgName,
  alternateName: ['THE CELLJET', 'SUMI THE CELLJET', '더셀젯'],
  url: site.url,
  logo: new URL('/images/logo-sumi.png', site.url).href,
  telephone: '+82-10-7781-6533',
  ...(site.email ? { email: site.email } : {}),
  address: {
    '@type': 'PostalAddress',
    streetAddress: '둔촌대로80번길 3-10, 212호',
    addressLocality: '성남시 중원구',
    addressRegion: '경기도',
    addressCountry: 'KR',
  },
  ...(site.company ? { legalName: site.company } : {}),
  ...(site.bizNumber ? { taxID: site.bizNumber } : {}),
  sameAs: [site.kakao],
};
const f = t.footer;
---
<!doctype html>
<html lang={t.htmlLang}>
<head>
  <meta charset="utf-8" />
  <script is:inline>document.documentElement.classList.add('js');</script>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {!noindex && langs.map((l) => <link rel="alternate" hreflang={dicts[l].hreflang} href={urlFor(l)} />)}
  {!noindex && <link rel="alternate" hreflang="x-default" href={urlFor('ko')} />}
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
  <meta name="naver-site-verification" content={site.naverVerification} />
  <meta name="google-site-verification" content={site.googleVerification} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={t.meta.siteName} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(ogImage, site.url).href} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content={t.ogLocale} />
  {langs.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={dicts[l].ogLocale} />)}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#006a61" />
  <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
  <script type="application/ld+json" set:html={JSON.stringify(org)} />
  {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
</head>
<body>
  <div class="topbar">
    <div class="wrap topbar-in">
      <span><b>{t.topbar.badge}</b> {t.topbar.text}</span>
      <a href={t.tel}>{t.topbar.call} {t.phone}</a>
    </div>
  </div>
  <header class="hd">
    <div class="wrap hd-in">
      <a href={home} class="logo" aria-label={t.homeAria}>
        <img src="/images/logo-sumi.webp" alt="SUMI BEAUTY" width="76" height="44" />
        <span class="logo-text">THE CELLJET</span>
      </a>
      <nav class="gnb" id="gnb" aria-label={t.menuAria}>
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
        <a href={`${p}/#contact`} class="btn btn-primary gnb-cta">{t.cta}</a>
      </nav>
      <div class="lang-sw" role="navigation" aria-label={t.langAria}>
        {langs.map((l) => (
          <a href={pathFor(l)} hreflang={dicts[l].hreflang} lang={dicts[l].htmlLang} aria-current={l === lang ? 'true' : undefined} title={dicts[l].langName}>{dicts[l].langShort}</a>
        ))}
      </div>
      <button class="menu-btn" aria-label={t.menuOpen} aria-controls="gnb" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="ft">
    <div class="wrap ft-in">
      <div>
        <div class="ft-logo">
          <img src="/images/logo-sumi-white.webp" alt="SUMI BEAUTY" width="69" height="40" />
          <span>THE CELLJET</span>
        </div>
        <p class="ft-desc">{f.desc[0]}<br />{f.desc[1]}</p>
      </div>
      <div class="ft-info">
        {f.companyName && <p>{f.company} {f.companyName}{f.ceoName && <> · {f.ceo} {f.ceoName}</>}</p>}
        {site.bizNumber && <p>{f.biz} {site.bizNumber}</p>}
        <p>{f.address}</p>
        <p>{f.tel} <a href={t.tel}>{t.phone}</a>{site.email && <> · {f.email} <a href={`mailto:${site.email}`}>{site.email}</a></>}</p>
        <p>{f.kakao} <a href={site.kakao} target="_blank" rel="noopener">THE CELLJET</a></p>
        <p>{f.mfr} {f.manufacturer}</p>
        <p class="ft-links"><a href={`${p}/privacy`}>{f.privacy}</a></p>
        <p class="copy">© {new Date().getFullYear()} THE CELLJET. All rights reserved.</p>
      </div>
    </div>
  </footer>

  <FloatingContact lang={lang} />

  <script>
    const btn = document.querySelector('.menu-btn');
    const gnb = document.getElementById('gnb');
    btn?.addEventListener('click', () => {
      const open = gnb!.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(open));
    });
    gnb?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => gnb.classList.remove('open')));

    // 스크롤하면 상단 메뉴를 얇게
    const hd = document.querySelector('.hd');
    const onScroll = () => hd?.classList.toggle('scrolled', scrollY > 40);
    addEventListener('scroll', onScroll, { passive: true }); onScroll();

    // 화면에 들어오는 요소 부드럽게 등장
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' });
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

    // 지금 보고 있는 섹션의 메뉴 강조
    const links = [...document.querySelectorAll<HTMLAnchorElement>('.gnb a[href*="#"]')];
    const so = new IntersectionObserver((es) => es.forEach((e) => {
      if (!e.isIntersecting) return;
      links.forEach((a) => a.classList.toggle('on', a.hash === '#' + e.target.id));
    }), { rootMargin: '-45% 0px -50% 0px' });
    links.forEach((a) => { const s = document.getElementById(a.hash.slice(1)); if (s) so.observe(s); });
  </script>
</body>
</html>

<style>
  .topbar { background: #004b44; color: #9ff5ea; font-size: 13px; }
  .topbar-in { display: flex; justify-content: space-between; align-items: center; height: 36px; gap: 12px; }
  .topbar b { background: var(--accent); color: #00201d; padding: 2px 7px; border-radius: 5px; font-size: 11px; margin-right: 6px; }
  .topbar a { color: #fff; text-decoration: none; font-weight: 700; }

  .hd { position: sticky; top: 0; z-index: 50; background: rgba(255,255,255,.94); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); }
  .hd-in { display: flex; align-items: center; height: 74px; gap: 20px; transition: height .25s; }
  .hd.scrolled { box-shadow: 0 6px 20px rgba(15,23,42,.07); }
  .hd.scrolled .hd-in { height: 62px; }
  .logo { display: flex; align-items: center; gap: 10px; text-decoration: none; color: var(--ink); }
  .logo img { height: 46px; width: auto; }
  .logo-text { font: 800 15px/1 var(--font-latin); letter-spacing: .08em; color: var(--brand); }
  .gnb { margin-left: auto; display: flex; align-items: center; gap: 2px; }
  .gnb a:not(.btn) { padding: 8px 12px; border-radius: 8px; color: var(--ink-2); font-weight: 700; font-size: 15px; text-decoration: none; }
  .gnb a:not(.btn):hover, .gnb a.on { color: var(--brand); background: var(--brand-soft); }
  .gnb-cta { margin-left: 10px; padding: 11px 18px; font-size: 15px; }
  .lang-sw { display: flex; gap: 2px; padding: 3px; border-radius: 10px; background: #f1f5f9; border: 1px solid var(--line); flex: none; }
  .lang-sw a { padding: 5px 9px; border-radius: 7px; font: 800 12.5px/1 var(--font-latin); color: var(--ink-3); text-decoration: none; }
  .lang-sw a:hover { color: var(--brand); }
  .lang-sw a[aria-current] { background: #fff; color: var(--brand); box-shadow: 0 1px 4px rgba(15,23,42,.1); }
  .menu-btn { display: none; margin-left: auto; width: 44px; height: 44px; border: 0; background: none; cursor: pointer; padding: 10px; }
  .menu-btn span { display: block; height: 2px; background: var(--ink); margin: 5px 0; border-radius: 2px; }

  .ft { background: var(--navy); color: #cbd5e1; padding: 56px 0 120px; font-size: 14.5px; }
  .ft-in { display: grid; grid-template-columns: 1.2fr 1fr; gap: 40px; }
  .ft-logo { display: flex; align-items: center; gap: 10px; color: #fff; font: 800 15px var(--font-latin); letter-spacing: .08em; }
  .ft-logo img { height: 36px; width: auto; }
  .ft-desc { margin-top: 14px; color: #94a3b8; }
  .ft-info { display: grid; gap: 4px; }
  .ft a { color: #e2e8f0; }
  .copy { margin-top: 10px; color: #64748b; }


  @media (max-width: 1080px) {
    .menu-btn { display: block; margin-left: 4px; }
    .lang-sw { margin-left: auto; }
    .gnb { display: none; position: absolute; top: 74px; left: 0; right: 0; flex-direction: column; align-items: stretch; background: #fff; border-bottom: 1px solid var(--line); padding: 12px 20px 20px; gap: 4px; box-shadow: var(--shadow); }
    .gnb.open { display: flex; }
    .gnb a:not(.btn) { padding: 12px; font-size: 16px; }
    .gnb-cta { margin: 8px 0 0; }
  }
  @media (max-width: 560px) {
    .logo-text { display: none; }
    .lang-sw a { padding: 6px 8px; }
  }
  @media (max-width: 900px) {
    .topbar span { display: none; }
    .topbar-in { justify-content: center; }
    .ft-in { grid-template-columns: 1fr; }
  }
</style>
