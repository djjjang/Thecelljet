---
// 관리 노트 글 한 편. 글 끝에 시연·도입 상담 상자가 자동으로 붙음
import Base from '../../layouts/Base.astro';
import { render } from 'astro:content';
import { site } from '../../data/site.js';
import { getT } from '../../i18n/index.js';
import { getPosts, formatDate, isoDate } from '../../data/blog.js';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({ params: { slug: post.id }, props: { post, newer: posts[i - 1], older: posts[i + 1] } }));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const t = getT('ko');
const url = new URL(`/blog/${post.id}`, site.url).href;
const schema = [{
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  description: d.description,
  datePublished: isoDate(d.date),
  author: { '@type': 'Organization', name: '더셀젯 THE CELLJET', url: site.url },
  publisher: { '@type': 'Organization', name: site.company || '더셀젯', url: site.url },
  mainEntityOfPage: url,
  articleSection: d.category,
  inLanguage: 'ko-KR',
}];
---
<Base title={d.title} description={d.description} path={`/blog/${post.id}`} koOnly ogType="article" schema={schema}>
  <article class="wrap art-wrap">
    <a href="/blog" class="back">← 관리 노트 목록</a>
    <p class="post-cat">{d.category}{!d.approved && <span class="check">대표님 확인 전</span>}</p>
    <h1 class="art-title">{d.title}</h1>
    <p class="art-meta">더셀젯 THE CELLJET · <time datetime={isoDate(d.date)}>{formatDate(d.date)}</time></p>

    <div class="art">
      <Content />
    </div>

    <aside class="art-box">
      <p class="art-box-title">더셀젯, 직접 보고 상담받아 보세요</p>
      <p>장비 시연 일정, 도입 조건 · 가격, 전용 앰플, 사용 교육까지 한 번에 안내해 드립니다.</p>
      <div class="art-btns">
        <a class="btn btn-primary" href="/#contact">시연 · 도입 상담 신청</a>
        <a class="btn btn-ghost" href={site.kakaoChat} target="_blank" rel="noopener">카카오톡 상담</a>
        <a class="btn btn-ghost" href={t.tel}>전화 {t.phone}</a>
      </div>
      <p class="note">이 글은 일반적인 관리 · 운영 정보입니다. 더셀젯은 화장품(앰플)을 피부에 전달하는 미용기기이며, 질환의 치료 · 예방을 위한 의료기기가 아닙니다.</p>
    </aside>

    {(newer || older) && (
      <nav class="pager" aria-label="다른 글">
        {older ? <a href={`/blog/${older.id}`}><span>이전 글</span>{older.data.title}</a> : <span></span>}
        {newer && <a href={`/blog/${newer.id}`} class="next"><span>다음 글</span>{newer.data.title}</a>}
      </nav>
    )}
  </article>
</Base>
