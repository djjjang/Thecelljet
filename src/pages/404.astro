---
import Base from '../layouts/Base.astro';
---
<Base title="페이지를 찾을 수 없습니다" description="요청하신 페이지를 찾을 수 없습니다." noindex>
  <section class="section">
    <div class="wrap nf">
      <h1 class="section-title">페이지를 찾을 수 없습니다</h1>
      <p class="section-lead">주소가 바뀌었거나 삭제된 페이지입니다.</p>
      <div class="back"><a href="/" class="btn btn-primary">처음으로</a></div>
    </div>
  </section>
</Base>

<style>
  .nf { text-align: center; padding: 40px 20px; }
  .back { margin-top: 32px; }
</style>
