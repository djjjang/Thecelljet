---
import Base from '../layouts/Base.astro';
---
<Base title="페이지를 찾을 수 없습니다 · Page not found" description="요청하신 페이지를 찾을 수 없습니다." noindex>
  <section class="section">
    <div class="wrap nf">
      <h1 class="section-title">페이지를 찾을 수 없습니다</h1>
      <p class="section-lead">주소가 바뀌었거나 삭제된 페이지입니다.</p>
      <p class="alt" lang="en">Page not found. · <span lang="zh-Hans">页面不存在。</span></p>
      <div class="back">
        <a href="/" class="btn btn-primary">처음으로</a>
        <a href="/en" class="btn btn-ghost" lang="en">English</a>
        <a href="/zh" class="btn btn-ghost" lang="zh-Hans">简体中文</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf { text-align: center; padding: 40px 20px; }
  .alt { margin-top: 8px; color: var(--ink-3); }
  .back { margin-top: 32px; display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; }
</style>
