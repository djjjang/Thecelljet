---
import { ampoules, ampouleIngredients, accessories, specSheet } from '../data/content.js';
const tabs = [
  { id: 'device', label: '본체 & 핸드피스' },
  { id: 'ampoule', label: '아톤플러스 앰플 6종' },
  { id: 'acc', label: '전용 부속품' },
];
const keySpecs = [
  { l: '분사 압력', v: '20~25 MPa', d: '전자기 제트 방식' },
  { l: '연속 샷', v: '최대 5 Hz', d: '바디 모드는 단발' },
  { l: '전용 카트리지', v: '0.5 cc', d: '끝까지 일정한 압력' },
  { l: '조작부', v: '10.1"', d: '컬러 LCD 터치스크린' },
];
---
<section class="section soft" id="lineup">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">Lineup</span>
      <h2 class="section-title">더셀젯 장비 · 전용 앰플 · 부속품</h2>
      <p class="section-lead">탭을 눌러 구성품을 하나씩 살펴보세요.</p>
    </div>

    <div class="tabs reveal" role="tablist" aria-label="구성품 보기">
      {tabs.map((t, i) => (
        <button type="button" role="tab" id={`tab-${t.id}`} aria-controls={`panel-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{t.label}</button>
      ))}
    </div>

    <!-- 본체 -->
    <div class="panel card" id="panel-device" role="tabpanel" aria-labelledby="tab-device">
      <div class="dev-grid">
        <div class="dev-visual">
          <div class="dev-tags"><span class="tag teal">전문가용 미용기기</span><span class="tag mono">KC R-R-IL6-SUMI THE CELLJET</span></div>
          <h3>SUMI THE CELLJET</h3>
          <p class="mono-sub">Cosmetic Delivery System · Needle-Free</p>
          <div class="dev-photo">
            <img src="/images/celljet-handpiece-use.webp" alt="더셀젯 본체와 자동 분사 핸드피스" loading="lazy" />
            <div class="dev-photo-cap"><b>본체 + 자동 분사 핸드피스</b><span>Made in Korea · I LASER LAB</span></div>
          </div>
          <div class="dev-btns">
            <button type="button" class="btn btn-ghost sm" data-open="spec-dialog">전체 사양 보기</button>
            <a href="#contact" class="btn btn-primary sm">장비 시연 신청</a>
          </div>
        </div>
        <div class="dev-info">
          <p class="mini-h">주요 사양</p>
          <div class="ks-grid">
            {keySpecs.map((k) => <div class="ks"><span>{k.l}</span><b>{k.v}</b><small>{k.d}</small></div>)}
          </div>
          <p class="mini-h">이런 점이 다릅니다</p>
          <ul class="adv">
            <li>듀얼 펄스로 분사를 두 번에 나눠, 앰플이 튀거나 버려지는 양을 줄입니다</li>
            <li>얼굴·목 · 두피 · 바디 · 스페셜 4가지 모드 × 9단계 강도</li>
            <li>핸드피스 터치 센서로 진동 · 레드 LED를 손끝에서 켜고 끕니다</li>
            <li>약 70℃ 과열 자동 정지, 압력 점검, 사용 기록, PIN 잠금</li>
          </ul>
          <div class="chips-row">
            <span>KC 적합등록</span><span>CE (LVD · EMC)</span><span>RoHS</span><span>특허 3건</span><span>1년 보증</span>
          </div>
        </div>
      </div>
    </div>

    <!-- 앰플 -->
    <div class="panel card" id="panel-ampoule" role="tabpanel" aria-labelledby="tab-ampoule" hidden>
      <div class="amp-hero">
        <img src="/images/aton-plus-6.webp" alt="아톤플러스(ATON PLUS) 앰플 6종: LS, MS, CS, RS, HS, FS" width="1212" height="396" loading="lazy" />
        <p>더셀젯 전용 앰플 라인 · 6종 · 모든 제품 PDRN 함유</p>
      </div>
      <div class="amp-wrap">
        <div class="amp-pick" role="radiogroup" aria-label="앰플 선택">
          {ampoules.map((a, i) => (
            <button type="button" class="amp-btn" role="radio" aria-checked={i === 0 ? 'true' : 'false'} data-amp={a.code} style={`--c:${a.color}`}>
              <img class="vial-img" src={`/images/aton-${a.code.toLowerCase()}.webp`} alt="" width="40" height="84" loading="lazy" />
              <span class="amp-txt"><b>{a.code}</b><small>{a.care}</small></span>
            </button>
          ))}
        </div>
        <div class="amp-detail">
          {ampoules.map((a, i) => (
            <article class="amp-card" data-amp-panel={a.code} hidden={i !== 0} style={`--c:${a.color}`}>
              <div class="amp-top">
                <img class="vial-big" src={`/images/aton-${a.code.toLowerCase()}.webp`} alt={`아톤플러스 ${a.code} ${a.name} 앰플`} width="120" height="252" loading="lazy" />
                <div>
                  <p class="amp-line">SUMI CELL.REJUVE</p>
                  <h3>ATON PLUS <span>{a.code}</span></h3>
                  <p class="amp-en">{a.name}</p>
                </div>
              </div>
              <dl class="amp-dl">
                <div><dt>관리 목적</dt><dd>{a.care}</dd></div>
                <div><dt>용량</dt><dd>{a.vol}</dd></div>
                <div><dt>주요 원료</dt><dd class="ingr">{ampouleIngredients[a.code].map((x) => <span>{x}</span>)}{ampouleIngredients[a.code].length === 1 && <span class="wrap">외 (전 성분은 제품 표시 사항 참고)</span>}</dd></div>
              </dl>
              <p class="amp-note">모든 아톤플러스 앰플에는 PDRN(Sodium DNA)이 들어 있습니다. 자세한 전 성분과 사용법은 제품 표시 사항을 확인해 주세요.</p>
            </article>
          ))}
        </div>
      </div>
    </div>

    <!-- 부속품 -->
    <div class="panel card" id="panel-acc" role="tabpanel" aria-labelledby="tab-acc" hidden>
      <div class="acc-grid">
        {accessories.map((a) => (
          <div class="acc">
            <img src={a.img} alt={a.name} loading="lazy" width="368" height="368" />
            <h3>{a.name}</h3>
            <p>{a.desc}</p>
          </div>
        ))}
      </div>
      <p class="acc-note">※ 전용 실린지 · 어댑터 · 실린지 캡은 시중 제품과도 호환됩니다. 카트리지 · 앰플 · 케이블 등 소모품은 보증 대상에서 제외됩니다.</p>
    </div>
  </div>
</section>

<dialog id="spec-dialog" class="dlg" aria-labelledby="spec-title">
  <div class="dlg-head">
    <h3 id="spec-title">더셀젯 전체 사양</h3>
    <button type="button" class="dlg-x" data-close aria-label="닫기">✕</button>
  </div>
  <table class="spec-tbl">
    <tbody>
      {specSheet.map(([k, v]) => <tr><th scope="row">{k}</th><td>{v}</td></tr>)}
    </tbody>
  </table>
  <p class="dlg-src">출처: 제조사 사용 설명서 (SUMI THE CELLJET Cosmetic Delivery System User Manual)</p>
</dialog>

<script>
  // 탭 전환 (키보드 화살표 지원)
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.tabs [role=tab]')];
  const select = (t: HTMLButtonElement) => {
    tabs.forEach((x) => {
      const on = x === t;
      x.setAttribute('aria-selected', String(on));
      x.tabIndex = on ? 0 : -1;
      document.getElementById(x.getAttribute('aria-controls')!)!.hidden = !on;
    });
  };
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => select(t));
    t.addEventListener('keydown', (e) => {
      const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (!d) return;
      const n = tabs[(i + d + tabs.length) % tabs.length];
      select(n); n.focus();
    });
  });

  // 앰플 선택
  const ampBtns = [...document.querySelectorAll<HTMLButtonElement>('.amp-btn')];
  ampBtns.forEach((b) => b.addEventListener('click', () => {
    ampBtns.forEach((x) => x.setAttribute('aria-checked', String(x === b)));
    document.querySelectorAll<HTMLElement>('[data-amp-panel]').forEach((p) => { p.hidden = p.dataset.ampPanel !== b.dataset.amp; });
  }));

  // 사양 팝업
  document.querySelectorAll<HTMLElement>('[data-open]').forEach((b) => b.addEventListener('click', () => {
    (document.getElementById(b.dataset.open!) as HTMLDialogElement).showModal();
  }));
  document.querySelectorAll<HTMLDialogElement>('dialog.dlg').forEach((d) => {
    d.querySelector('[data-close]')?.addEventListener('click', () => d.close());
    d.addEventListener('click', (e) => { if (e.target === d) d.close(); });
  });
</script>

<style>
  .tabs { display: flex; justify-content: center; gap: 6px; width: fit-content; max-width: 100%; margin: 0 auto 28px; padding: 6px; border-radius: 16px; background: #e2e8f0; overflow-x: auto; }
  .tabs button { flex: none; border: 0; background: none; padding: 12px 20px; border-radius: 12px; font: inherit; font-weight: 800; font-size: 15.5px; color: var(--ink-2); cursor: pointer; transition: background .2s, color .2s, box-shadow .2s; }
  .tabs button[aria-selected=true] { background: #fff; color: var(--brand); box-shadow: 0 4px 12px rgba(15,23,42,.08); }
  .panel { overflow: hidden; animation: fade .35s ease; }
  @keyframes fade { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }

  .dev-grid { display: grid; grid-template-columns: 1fr 1fr; }
  .dev-visual { padding: 32px; background: #f8fafc; border-right: 1px solid var(--line); display: flex; flex-direction: column; }
  .dev-tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .tag { padding: 5px 11px; border-radius: 999px; font-size: 12.5px; font-weight: 800; background: #fff; border: 1px solid var(--line); }
  .tag.teal { background: var(--accent); border-color: var(--accent); color: #00201d; }
  .tag.mono { font-family: var(--font-latin); font-size: 11.5px; color: var(--ink-2); }
  .dev-visual h3 { margin-top: 14px; font: 800 28px var(--font-latin); }
  .mono-sub { font: 600 13px var(--font-latin); color: var(--brand); }
  .dev-photo { position: relative; margin: 22px 0; border-radius: 18px; overflow: hidden; background: #1a1f2b; }
  .dev-photo img { width: 100%; aspect-ratio: 5 / 4; object-fit: cover; transition: transform .6s; }
  .dev-photo:hover img { transform: scale(1.04); }
  .dev-photo-cap { position: absolute; left: 0; right: 0; bottom: 0; padding: 30px 18px 14px; background: linear-gradient(transparent, rgba(6,10,20,.88)); color: #fff; display: grid; }
  .dev-photo-cap span { font-size: 12.5px; color: #7ff0e2; }
  .dev-btns { display: flex; flex-wrap: wrap; gap: 10px; margin-top: auto; }
  .btn.sm { padding: 11px 18px; font-size: 15px; }
  .dev-info { padding: 32px; }
  .mini-h { font: 800 12px var(--font-latin); letter-spacing: .12em; color: var(--ink-3); text-transform: uppercase; margin: 0 0 12px; }
  .mini-h:not(:first-child) { margin-top: 28px; }
  .ks-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .ks { padding: 14px 16px; border-radius: 14px; background: #f8fafc; border: 1px solid var(--line); display: grid; }
  .ks span { font-size: 13px; color: var(--ink-3); }
  .ks b { font: 800 20px var(--font-latin); color: var(--brand); }
  .ks small { font-size: 12.5px; color: var(--ink-3); }
  .adv { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .adv li { padding: 12px 14px 12px 40px; border: 1px solid var(--line); border-radius: 12px; position: relative; font-size: 15px; }
  .adv li::before { content: '✓'; position: absolute; left: 14px; top: 11px; color: var(--accent); font-weight: 900; }
  .chips-row { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 22px; padding-top: 18px; border-top: 1px solid var(--line); }
  .chips-row span { padding: 5px 10px; border-radius: 8px; background: #f1f5f9; border: 1px solid var(--line); font-size: 13px; font-weight: 700; color: var(--ink-2); }

  /* 앰플 */
  .amp-wrap { display: grid; grid-template-columns: 300px 1fr; }
  .amp-pick { padding: 20px; background: #f8fafc; border-right: 1px solid var(--line); display: grid; gap: 8px; align-content: start; }
  .amp-btn { display: flex; align-items: center; gap: 12px; padding: 10px 14px; border-radius: 14px; border: 1px solid transparent; background: none; font: inherit; text-align: left; cursor: pointer; transition: background .2s, border-color .2s; }
  .amp-btn:hover { background: #fff; }
  .amp-btn[aria-checked=true] { background: #fff; border-color: var(--c); box-shadow: 0 4px 14px rgba(15,23,42,.06); }
  .amp-txt { display: grid; }
  .amp-txt b { font: 800 18px var(--font-latin); color: var(--c); }
  .amp-txt small { font-size: 13.5px; color: var(--ink-2); font-weight: 600; }
  .amp-hero { padding: 32px 32px 20px; text-align: center; background: linear-gradient(180deg, #fff, #f8fafc); border-bottom: 1px solid var(--line); }
  .amp-hero img { max-width: 760px; width: 100%; margin: 0 auto; filter: drop-shadow(0 14px 18px rgba(15,23,42,.12)); }
  .amp-hero p { margin-top: 10px; font-size: 14.5px; font-weight: 700; color: var(--ink-3); }
  .vial-img { flex: none; width: 34px; height: auto; }
  .vial-big { flex: none; width: 110px; height: auto; filter: drop-shadow(0 14px 16px rgba(15,23,42,.18)); }
  .vial { position: relative; flex: none; width: 26px; height: 40px; border-radius: 5px 5px 7px 7px; background: linear-gradient(90deg, rgba(255,255,255,.9), rgba(226,232,240,.9) 60%, #fff); border: 1px solid #cbd5e1; }
  .vial::before { content: ''; position: absolute; top: -7px; left: 3px; right: 3px; height: 9px; border-radius: 3px; background: var(--c); }
  .vial i { position: absolute; left: 3px; right: 3px; bottom: 3px; height: 55%; border-radius: 3px; background: color-mix(in srgb, var(--c) 25%, transparent); }
  .vial.big { width: 56px; height: 86px; border-radius: 9px 9px 12px 12px; }
  .vial.big::before { top: -13px; left: 6px; right: 6px; height: 16px; border-radius: 5px; }
  .amp-detail { padding: 36px; }
  .amp-card { animation: fade .3s ease; }
  .amp-top { display: flex; gap: 24px; align-items: center; }
  .amp-line { font: 700 12px var(--font-latin); letter-spacing: .1em; color: var(--ink-3); }
  .amp-card h3 { font: 800 30px var(--font-latin); }
  .amp-card h3 span { color: var(--c); }
  .amp-en { font: 600 15px var(--font-latin); color: var(--ink-2); }
  .amp-dl { margin: 28px 0 0; display: grid; gap: 10px; }
  .amp-dl div { display: grid; grid-template-columns: 110px 1fr; gap: 12px; padding: 14px 16px; border-radius: 12px; background: #f8fafc; border: 1px solid var(--line); }
  .amp-dl dt { font-weight: 800; color: var(--ink-3); font-size: 14.5px; }
  .amp-dl dd { margin: 0; font-weight: 700; }
  .ingr { display: flex; flex-wrap: wrap; gap: 6px; }
  .ingr span { white-space: nowrap; padding: 3px 10px; border-radius: 999px; background: #fff; border: 1px solid var(--line); font: 600 13.5px var(--font-latin); }
  .ingr span.wrap { white-space: normal; padding: 3px 0; border: 0; background: none; font: 600 13.5px inherit; color: var(--ink-3); }
  .amp-note { margin-top: 18px; font-size: 14px; color: var(--ink-3); }

  /* 부속품 */
  .acc-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; padding: 36px; }
  .acc { text-align: center; }
  .acc img { width: 180px; margin: 0 auto 14px; border-radius: 50%; transition: transform .3s; }
  .acc:hover img { transform: translateY(-4px); }
  .acc h3 { font-size: 18px; }
  .acc p { color: var(--ink-3); font-size: 15px; }
  .acc-note { padding: 0 36px 32px; font-size: 14px; color: var(--ink-3); text-align: center; }

  /* 사양 팝업 */
  .dlg { width: min(680px, calc(100% - 32px)); max-height: 86vh; border: 0; border-radius: 20px; padding: 0; box-shadow: 0 30px 80px rgba(0,0,0,.35); }
  .dlg::backdrop { background: rgba(10,15,29,.6); backdrop-filter: blur(3px); }
  .dlg-head { position: sticky; top: 0; display: flex; justify-content: space-between; align-items: center; padding: 18px 24px; background: var(--navy); color: #fff; }
  .dlg-head h3 { font-size: 19px; }
  .dlg-x { border: 0; background: rgba(255,255,255,.12); color: #fff; width: 36px; height: 36px; border-radius: 10px; font-size: 16px; cursor: pointer; }
  .spec-tbl { width: 100%; border-collapse: collapse; font-size: 15px; }
  .spec-tbl th, .spec-tbl td { padding: 11px 24px; border-bottom: 1px solid var(--line); text-align: left; vertical-align: top; }
  .spec-tbl th { width: 38%; color: var(--ink-3); font-weight: 700; background: #f8fafc; }
  .dlg-src { padding: 14px 24px 20px; font-size: 13px; color: var(--ink-3); }

  @media (max-width: 900px) {
    .tabs { width: 100%; justify-content: flex-start; }
    .tabs button { padding: 11px 14px; font-size: 14.5px; }
    .dev-grid, .amp-wrap { grid-template-columns: 1fr; }
    .dev-visual { border-right: 0; border-bottom: 1px solid var(--line); padding: 22px; }
    .dev-info, .amp-detail { padding: 22px; }
    .amp-pick { grid-template-columns: 1fr 1fr; border-right: 0; border-bottom: 1px solid var(--line); padding: 14px; }
    .amp-btn { padding: 8px 10px; }
    .amp-dl div { grid-template-columns: 1fr; gap: 2px; }
    .acc-grid { grid-template-columns: 1fr; padding: 24px; }
    .acc-note { padding: 0 24px 24px; }
    .spec-tbl th, .spec-tbl td { padding: 10px 14px; }
  }
</style>
