---
import { site } from '../data/site.js';
import { getT, prefix } from '../i18n/index.js';
const { lang = 'ko' } = Astro.props;
const t = getT(lang);
const F = t.form;
const p = prefix(lang);
const quickHref = { kakao: site.kakaoChat, sms: site.sms, email: `mailto:${site.email}` };
const [beforePrivacy, afterPrivacy] = F.agreeDetail.split('{privacy}');
// 화면 스크립트용 문장
const msgs = { errAgree: F.errAgree, errReq: F.errReq, notReady: F.notReady, fail: F.fail, submit: F.submit, sending: F.sending, locale: F.dateLocale, thanks: `${p}/thanks`, lang };
---
<section class="section lead" id="contact">
  <div class="wrap lead-in">
    <div class="lead-copy">
      <span class="eyebrow">Contact</span>
      <h2 class="section-title" set:html={F.title} />
      <p class="section-lead" set:html={F.lead} />
      <ul class="checks">
        {F.checks.map((x) => <li>{x}</li>)}
      </ul>
      <p class="lead-phone">{F.urgent}<br /><a href={t.tel}>{t.phone}</a></p>
      <div class="quick">
        {F.quick.map(([k, label]) => <a class={`q ${k}`} href={quickHref[k]} {...(k === 'kakao' ? { target: '_blank', rel: 'noopener' } : {})}>{label}</a>)}
      </div>
    </div>

    <form class="card lead-form" data-endpoint={site.formEndpoint} data-i18n={JSON.stringify(msgs)} novalidate>
      <div class="row2">
        <label>{F.shop} <b>*</b>
          <input name="shop" required autocomplete="organization" placeholder={F.shopPh} />
        </label>
        <label>{F.name} <b>*</b>
          <input name="name" required autocomplete="name" placeholder={F.namePh} />
        </label>
      </div>
      <div class="row2">
        <label>{F.phone} <b>*</b>
          <input name="phone" required type="tel" autocomplete="tel" inputmode="tel" placeholder={F.phonePh} />
        </label>
        <label>{F.region} <span class="opt">{F.optional}</span>
          <input name="region" autocomplete="address-level1" placeholder={F.regionPh} />
        </label>
      </div>
      <label>{F.type} <b>*</b>
        <select name="type" required>
          <option value="">{F.select}</option>
          {F.types.map((x) => <option>{x}</option>)}
        </select>
      </label>
      <fieldset>
        <legend>{F.interest} <span class="opt">{F.multi}</span></legend>
        <div class="chips">
          {F.interests.map((i) => <label class="chip"><input type="checkbox" name="interest" value={i} /> <span>{i}</span></label>)}
        </div>
      </fieldset>
      <label>{F.message} <span class="opt">{F.optional}</span>
        <textarea name="message" rows="3" placeholder={F.messagePh}></textarea>
      </label>
      <input type="text" name="company_hp" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

      <div class="agree">
        <label class="chk"><input type="checkbox" name="agree_privacy" required /> <span><b>{F.agreeReq}</b> {F.agree}</span></label>
        <details>
          <summary>{F.view}</summary>
          <p>{beforePrivacy}<a href={`${p}/privacy`}>{t.footer.privacy}</a>{afterPrivacy}</p>
        </details>
        <label class="chk"><input type="checkbox" name="agree_marketing" /> <span><b class="opt">{F.agreeOpt}</b> {F.marketing}</span></label>
      </div>

      <button type="submit" class="btn btn-primary submit">{F.submit}</button>
      <p class="form-msg" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLFormElement>('.lead-form').forEach((form) => {
    const msg = form.querySelector<HTMLElement>('.form-msg')!;
    const btn = form.querySelector<HTMLButtonElement>('.submit')!;
    const L = JSON.parse(form.dataset.i18n || '{}');
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      msg.className = 'form-msg';
      const fd = new FormData(form);
      if ((fd.get('company_hp') as string)?.length) return; // 스팸 방지
      const missing = [...form.querySelectorAll<HTMLInputElement>('[required]')].find((el) =>
        el.type === 'checkbox' ? !el.checked : !el.value.trim());
      if (missing) {
        msg.textContent = missing.type === 'checkbox' ? L.errAgree : L.errReq;
        msg.classList.add('err');
        missing.focus();
        return;
      }
      const data = new URLSearchParams();
      ['shop', 'name', 'phone', 'region', 'type', 'message'].forEach((k) => data.set(k, String(fd.get(k) || '').trim()));
      data.set('interest', fd.getAll('interest').join(', '));
      data.set('agree_privacy', 'Y');
      data.set('agree_marketing', fd.get('agree_marketing') ? 'Y' : 'N');
      data.set('page', location.pathname);
      data.set('lang', L.lang);
      data.set('submitted_at', new Date().toLocaleString('ko-KR'));

      const endpoint = form.dataset.endpoint;
      if (!endpoint) {
        msg.textContent = L.notReady;
        msg.classList.add('err');
        return;
      }
      btn.disabled = true;
      btn.textContent = L.sending;
      try {
        await fetch(endpoint, { method: 'POST', mode: 'no-cors', body: data });
        location.href = L.thanks;
      } catch {
        btn.disabled = false;
        btn.textContent = L.submit;
        msg.textContent = L.fail;
        msg.classList.add('err');
      }
    });
  });
</script>

<style>
  .lead { background: linear-gradient(180deg, var(--brand-soft), #fff); }
  .lead-in { display: grid; grid-template-columns: 1fr 1.15fr; gap: 56px; align-items: start; }
  .lead-copy .section-title { margin-top: 16px; }
  .lead-phone { margin-top: 28px; color: var(--ink-2); }
  .lead-phone a { font: 800 26px/1.4 var(--font-latin); text-decoration: none; }
  .quick { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
  .q { padding: 11px 18px; border-radius: 12px; font-weight: 800; font-size: 15px; text-decoration: none; }
  .q.kakao { background: #FEE500; color: #191919; }
  .q.email { background: #fff; color: #0369a1; border: 1px solid #bae6fd; }
  .q.sms { background: #fff; color: var(--ink); border: 1px solid #cbd5e1; }
  .q.sms { display: none; }
  @media (max-width: 900px) { .q.sms { display: inline-block; } }
  .lead-form { display: grid; gap: 16px; padding: 32px; }
  .row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .lead-form label, .lead-form legend { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 4px; font-weight: 700; font-size: 15.5px; }
  .lead-form label > input:not([type=checkbox]), .lead-form label > select, .lead-form label > textarea { flex-basis: 100%; }
  .lead-form b { color: #d4380d; }
  .opt { color: var(--ink-3); font-weight: 500; font-size: 14px; }
  input:not([type=checkbox]), select, textarea {
    width: 100%; font: inherit; font-size: 16px; font-weight: 500; color: var(--ink);
    padding: 12px 14px; border: 1px solid #cbd5e1; border-radius: 10px; background: #fff;
  }
  input:focus, select:focus, textarea:focus { outline: 2px solid var(--accent); outline-offset: 0; border-color: transparent; }
  fieldset { border: 0; padding: 0; margin: 0; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
  .chip { display: inline-flex !important; grid-template-columns: none; align-items: center; gap: 6px; padding: 8px 12px; border: 1px solid #cbd5e1; border-radius: 999px; font-weight: 600 !important; font-size: 14.5px !important; cursor: pointer; }
  .chip:has(input:checked) { border-color: var(--brand); background: var(--brand-soft); color: var(--brand); }
  .chip input { accent-color: var(--brand); }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; }
  .agree { display: grid; gap: 8px; font-size: 14.5px; }
  .chk { display: flex !important; align-items: flex-start; gap: 8px; font-weight: 600 !important; font-size: 14.5px !important; cursor: pointer; }
  .chk input { margin-top: 5px; accent-color: var(--brand); width: 16px; height: 16px; }
  details { color: var(--ink-3); font-size: 13.5px; }
  summary { cursor: pointer; }
  .submit { width: 100%; padding: 16px; font-size: 17px; }
  .submit:disabled { opacity: .6; cursor: wait; }
  .form-msg { font-weight: 700; font-size: 15px; min-height: 1px; }
  .form-msg.err { color: #c2410c; }

  @media (max-width: 900px) {
    .lead-in { grid-template-columns: 1fr; gap: 32px; }
    .lead-form { padding: 22px; }
    .row2 { grid-template-columns: 1fr; }
  }
</style>
