---
import { modes, modeNotes } from '../data/content.js';
// 실제 장비 화면 순서: SPECIAL, SCALP / FACE & NECK, BODY
const order = ['SPECIAL', 'SCALP', 'FACE & NECK', 'BODY'];
const sorted = order.map((k) => modes.find((m) => m.key === k));
const icons = {
  'SPECIAL': '<path d="M12 3l1.8 4.2L18 9l-4.2 1.8L12 15l-1.8-4.2L6 9l4.2-1.8z"/><path d="M18 15l.9 2.1L21 18l-2.1.9L18 21l-.9-2.1L15 18l2.1-.9z"/>',
  'SCALP': '<path d="M5 13a7 7 0 0 1 14 0v2a3 3 0 0 1-3 3H8a3 3 0 0 1-3-3z"/><path d="M8 9c1.5 1 6.5 1 8 0"/>',
  'FACE & NECK': '<circle cx="12" cy="9" r="5"/><path d="M9 14v3m6-3v3M6 21c1-2 3.5-3 6-3s5 1 6 3"/>',
  'BODY': '<path d="M8 3c0 6 1 9 0 18M16 3c0 6-1 9 0 18"/><path d="M10 13c1 1 3 1 4 0"/>',
};
---
<section class="section dark" id="modes">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow on-dark">Treatment Area · 화면 체험</span>
      <h2 class="section-title">부위에 맞춘 4가지 모드,<br /> 직접 눌러 보세요</h2>
      <p class="section-lead">더셀젯 10.1인치 터치스크린을 본뜬 체험 화면입니다.<br /> 모드를 고르고, 샷 수와 강도를 조절한 뒤 START를 눌러 보세요.</p>
    </div>

    <div class="sim-grid">
      <div class="screen reveal" id="sim" aria-label="더셀젯 조작 화면 체험">
        <div class="scr-top">
          <img src="/images/logo-sumi-white.webp" alt="" width="52" height="30" />
          <span class="scr-status" data-status>READY</span>
        </div>
        <div class="scr-body">
          <div class="area">
            <p class="scr-label">Treatment Area</p>
            <div class="area-grid">
              {sorted.map((m, i) => (
                <button type="button" class="area-btn" data-mode={m.key} aria-pressed={m.key === 'FACE & NECK' ? 'true' : 'false'}>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[m.key]} />
                  <span>{m.key}</span>
                </button>
              ))}
            </div>
          </div>
          <div class="ctrl">
            <div class="ctrl-row">
              <span class="ctrl-l">Shot / Second</span>
              <output class="ctrl-v" data-hz>3</output><span class="unit">Hz</span>
              <div class="ud"><button type="button" data-hz-up aria-label="초당 샷 수 올리기">▲</button><button type="button" data-hz-down aria-label="초당 샷 수 내리기">▼</button></div>
            </div>
            <div class="ctrl-row">
              <span class="ctrl-l">Intensity</span>
              <output class="ctrl-v" data-int>5</output><span class="unit">/ 9</span>
              <div class="ud"><button type="button" data-int-up aria-label="강도 올리기">▲</button><button type="button" data-int-down aria-label="강도 내리기">▼</button></div>
            </div>
            <div class="bars" aria-hidden="true">{Array.from({ length: 9 }).map(() => <i></i>)}</div>
          </div>
        </div>
        <div class="scr-bottom">
          <button type="button" class="mem save" data-save aria-label="현재 설정 저장">SAVE</button>
          {[1, 2, 3, 4, 5].map((n) => <button type="button" class="mem" data-mem={n} aria-label={`메모리 ${n}`}>{n}<small>Memory</small></button>)}
          <div class="count"><span>SHOT<br />COUNT</span><output data-count>000000</output></div>
          <button type="button" class="start" data-start aria-label="분사 시작">▶<small>START</small></button>
        </div>
        <div class="pulse" aria-hidden="true"></div>
      </div>

      <div class="sim-side reveal">
        {sorted.map((m) => (
          <div class="mode-info" data-info={m.key} hidden={m.key !== 'FACE & NECK'}>
            <span class="mode-key">{m.key} MODE</span>
            <h3>{m.name}</h3>
            <p>{m.desc}</p>
          </div>
        ))}
        <p class="sim-msg" data-msg role="status" aria-live="polite">현재 설정: 얼굴 · 목 모드 · 초당 3회 · 강도 5단계</p>
        <ul class="checks">
          {modeNotes.map((n) => <li>{n}</li>)}
        </ul>
        <p class="sim-note">※ 실제 장비 화면을 단순화한 체험용 화면입니다. 실제 사용 조건은 교육 시 안내해 드립니다.</p>
      </div>
    </div>
  </div>
</section>

<script>
  const root = document.getElementById('sim');
  if (root) {
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const names: Record<string, string> = { 'SPECIAL': '스페셜', 'SCALP': '두피', 'FACE & NECK': '얼굴 · 목', 'BODY': '바디' };
    const st = { mode: 'FACE & NECK', hz: 3, int: 5, count: 0, saving: false, timer: 0 as number | undefined, mem: {} as Record<string, { mode: string; hz: number; int: number }> };
    const msg = document.querySelector<HTMLElement>('[data-msg]')!;
    const status = $<HTMLElement>('[data-status]');

    const render = (note?: string) => {
      const body = st.mode === 'BODY';
      const hz = body ? 1 : st.hz; // 바디 모드는 1회 단발 고정, 다른 모드로 돌아가면 원래 값 복원
      $<HTMLOutputElement>('[data-hz]').textContent = String(hz);
      $<HTMLOutputElement>('[data-int]').textContent = String(st.int);
      $<HTMLOutputElement>('[data-count]').textContent = String(st.count).padStart(6, '0');
      root.querySelectorAll<HTMLButtonElement>('[data-hz-up],[data-hz-down]').forEach((b) => (b.disabled = body));
      root.querySelectorAll<HTMLElement>('.bars i').forEach((b, i) => b.classList.toggle('on', i < st.int));
      root.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.mode === st.mode)));
      document.querySelectorAll<HTMLElement>('[data-info]').forEach((p) => (p.hidden = p.dataset.info !== st.mode));
      root.querySelectorAll<HTMLElement>('[data-mem]').forEach((b) => b.classList.toggle('filled', !!st.mem[b.dataset.mem!]));
      root.style.setProperty('--hz', String(hz));
      msg.textContent = note || `현재 설정: ${names[st.mode]} 모드 · ${body ? '트리거 1회 단발' : `초당 ${hz}회`} · 강도 ${st.int}단계`;
    };
    const stop = () => { clearInterval(st.timer); st.timer = undefined; root.classList.remove('firing'); status.textContent = 'READY'; };

    root.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((b) => b.addEventListener('click', () => { stop(); st.mode = b.dataset.mode!; render(); }));
    $('[data-hz-up]').addEventListener('click', () => { st.hz = Math.min(5, st.hz + 1); render(); });
    $('[data-hz-down]').addEventListener('click', () => { st.hz = Math.max(1, st.hz - 1); render(); });
    $('[data-int-up]').addEventListener('click', () => { st.int = Math.min(9, st.int + 1); render(); });
    $('[data-int-down]').addEventListener('click', () => { st.int = Math.max(1, st.int - 1); render(); });
    $('[data-save]').addEventListener('click', () => { st.saving = !st.saving; $('[data-save]').classList.toggle('armed', st.saving); render(st.saving ? '저장할 메모리 번호(1~5)를 눌러 주세요.' : undefined); });
    root.querySelectorAll<HTMLButtonElement>('[data-mem]').forEach((b) => b.addEventListener('click', () => {
      const k = b.dataset.mem!;
      if (st.saving) {
        st.mem[k] = { mode: st.mode, hz: st.hz, int: st.int };
        st.saving = false; $('[data-save]').classList.remove('armed');
        render(`메모리 ${k}에 저장했습니다: ${names[st.mode]} · ${st.mode === 'BODY' ? 1 : st.hz}Hz · 강도 ${st.int}`);
      } else if (st.mem[k]) {
        stop(); Object.assign(st, st.mem[k]);
        render(`메모리 ${k}를 불러왔습니다: ${names[st.mode]} · ${st.mode === 'BODY' ? 1 : st.hz}Hz · 강도 ${st.int}`);
      } else {
        render(`메모리 ${k}는 비어 있습니다. SAVE를 누른 뒤 번호를 눌러 저장해 보세요.`);
      }
    }));
    $('[data-start]').addEventListener('click', () => {
      if (st.timer) return stop();
      root.classList.add('firing'); status.textContent = 'RUNNING';
      if (st.mode === 'BODY') { st.count += 1; render(); setTimeout(stop, 700); return; }
      st.timer = window.setInterval(() => { st.count += 1; render(); }, 1000 / st.hz);
      setTimeout(stop, 3000);
    });
    render();
  }
</script>

<style>
  .sim-grid { display: grid; grid-template-columns: 1.25fr 1fr; gap: 40px; align-items: center; }
  .screen { position: relative; overflow: hidden; padding: 18px; border-radius: 22px; color: #fff; user-select: none;
    background: radial-gradient(600px 300px at 20% 110%, rgba(0,196,180,.14), transparent 60%), linear-gradient(160deg, #1b2347, #0e1430 55%, #0b1026);
    border: 1px solid rgba(255,255,255,.14); box-shadow: 0 30px 70px rgba(0,0,0,.45), inset 0 0 0 6px #0a0e1f; }
  .scr-top { display: flex; justify-content: space-between; align-items: center; padding: 4px 6px 12px; }
  .scr-top img { height: 26px; width: auto; }
  .scr-status { font: 800 11.5px var(--font-latin); letter-spacing: .12em; padding: 4px 10px; border-radius: 999px; background: rgba(0,196,180,.18); color: #7ff0e2; }
  .firing .scr-status { background: #00c4b4; color: #00201d; }
  .scr-body { display: grid; grid-template-columns: 1fr 1.25fr; gap: 14px; }
  .scr-label { font: 800 17px var(--font-latin); margin-bottom: 10px; }
  .area-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .area-btn { display: grid; justify-items: center; gap: 6px; padding: 14px 6px 10px; border-radius: 14px; border: 1px solid rgba(255,255,255,.12); background: linear-gradient(180deg, #2a3360, #1d2448); color: #c7d2fe; font: 700 11px var(--font-latin); letter-spacing: .04em; cursor: pointer; transition: transform .15s, background .2s, box-shadow .2s; }
  .area-btn svg { width: 30px; height: 30px; }
  .area-btn:hover { transform: translateY(-2px); }
  .area-btn[aria-pressed=true] { background: linear-gradient(160deg, #19e3c8, #1593e6); color: #fff; border-color: transparent; box-shadow: 0 8px 22px rgba(21,147,230,.4); }
  .ctrl { padding: 16px; border-radius: 16px; background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.1); display: grid; gap: 12px; align-content: center; }
  .ctrl-row { display: grid; grid-template-columns: 1fr auto auto auto; align-items: center; gap: 8px; padding-bottom: 12px; border-bottom: 1px solid rgba(255,255,255,.08); }
  .ctrl-l { font: 600 13px var(--font-latin); color: #c7d2fe; }
  .ctrl-v { min-width: 62px; text-align: center; padding: 6px 0; border-radius: 8px; background: #cbd5e1; color: #0b1026; font: 800 24px var(--font-latin); }
  .unit { font: 700 12px var(--font-latin); color: #94a3b8; width: 30px; }
  .ud { display: grid; gap: 4px; }
  .ud button { width: 34px; height: 24px; border: 0; border-radius: 6px; background: rgba(255,255,255,.1); color: #fff; font-size: 11px; cursor: pointer; }
  .ud button:hover:not(:disabled) { background: rgba(0,196,180,.4); }
  .ud button:disabled { opacity: .25; cursor: not-allowed; }
  .bars { display: grid; grid-template-columns: repeat(9, 1fr); gap: 4px; align-items: end; height: 26px; }
  .bars i { display: block; border-radius: 3px; background: rgba(255,255,255,.12); transition: background .2s; }
  .bars i:nth-child(1){height:30%}.bars i:nth-child(2){height:38%}.bars i:nth-child(3){height:46%}.bars i:nth-child(4){height:54%}.bars i:nth-child(5){height:62%}.bars i:nth-child(6){height:70%}.bars i:nth-child(7){height:80%}.bars i:nth-child(8){height:90%}.bars i:nth-child(9){height:100%}
  .bars i.on { background: linear-gradient(180deg, #19e3c8, #1593e6); }
  .scr-bottom { display: flex; align-items: center; gap: 7px; margin-top: 14px; padding: 10px; border-radius: 14px; background: rgba(0,0,0,.25); }
  .mem { flex: none; width: 46px; height: 46px; border-radius: 10px; border: 1px solid rgba(255,255,255,.12); background: #222a52; color: #fff; font: 800 16px/1 var(--font-latin); cursor: pointer; display: grid; place-content: center; gap: 2px; }
  .mem small { font-size: 8px; font-weight: 600; color: #94a3b8; }
  .mem.filled { border-color: #19e3c8; box-shadow: inset 0 -3px 0 #19e3c8; }
  .mem.save { font-size: 10px; letter-spacing: .06em; color: #c7d2fe; }
  .mem.save.armed { background: #f59e0b; color: #1f1300; animation: blink 1s infinite; }
  @keyframes blink { 50% { opacity: .6; } }
  .count { margin-left: auto; display: flex; align-items: center; gap: 6px; padding: 6px 8px; border-radius: 10px; background: #222a52; font: 700 9px/1.1 var(--font-latin); color: #c7d2fe; }
  .count output { min-width: 78px; padding: 5px 6px; border-radius: 6px; background: #cbd5e1; color: #0b1026; font: 800 15px var(--font-latin); text-align: center; }
  .start { flex: none; width: 50px; height: 50px; border: 0; border-radius: 12px; background: linear-gradient(160deg, #19e3c8, #1593e6); color: #fff; font: 800 15px/1 var(--font-latin); cursor: pointer; display: grid; place-content: center; gap: 1px; }
  .start small { font-size: 8px; }
  .firing .start { background: #f43f5e; }
  .pulse { position: absolute; right: 60px; bottom: 30px; width: 20px; height: 20px; border-radius: 50%; pointer-events: none; opacity: 0; }
  .firing .pulse { opacity: 1; animation: ring calc(1s / var(--hz, 1)) ease-out infinite; }
  @keyframes ring { from { box-shadow: 0 0 0 0 rgba(25,227,200,.7); } to { box-shadow: 0 0 0 60px rgba(25,227,200,0); } }

  .sim-side .mode-info { animation: fadeIn .3s ease; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  .sim-side h3 { color: #fff; font-size: 26px; margin: 6px 0 10px; }
  .sim-side p { color: #cbd5e1; }
  .mode-key { font: 800 12px var(--font-latin); letter-spacing: .14em; color: #7ff0e2; }
  .sim-msg { margin: 22px 0; padding: 14px 16px; border-radius: 12px; background: rgba(0,196,180,.1); border: 1px solid rgba(0,196,180,.3); color: #e2fffb !important; font-weight: 700; font-size: 15px; }
  .sim-side .checks { color: #e2e8f0; }
  .sim-note { margin-top: 18px; font-size: 13.5px; color: #94a3b8 !important; }

  @media (max-width: 1000px) {
    .sim-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .screen { padding: 12px; border-radius: 16px; }
    .scr-body { grid-template-columns: 1fr; }
    .area-btn { padding: 10px 4px 8px; }
    .area-btn svg { width: 24px; height: 24px; }
    .scr-bottom { flex-wrap: wrap; gap: 6px; }
    .mem { width: 40px; height: 40px; }
    .count { margin-left: 0; }
  }
</style>
