---
// 전후 비교 슬라이더. 근거가 모두 채워진 사례만 화면에 나온다 (content.js의 beforeAfter)
import { beforeAfter } from '../data/content.js';
const required = ['before', 'after', 'area', 'sessions', 'period', 'shotDate', 'consent'];
const approved = beforeAfter.filter((c) => required.every((k) => c[k]) && c.consent === true);
// 검토 중 사례: src/data/ba-draft.json (깃허브에 안 올라감). 내 컴퓨터 미리보기(npm run dev)에서만 보임
const draftFiles = import.meta.glob('../data/ba-draft.json', { eager: true, import: 'default' });
const drafts = import.meta.env.DEV ? (Object.values(draftFiles)[0] || []).map((c) => ({ ...c, draft: true })) : [];
const cases = [...approved, ...drafts];
---
{cases.length > 0 && (
<section class="section" id="cases">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">Before & After</span>
      <h2 class="section-title">더셀젯 관리 전 · 후</h2>
      <p class="section-lead">가운데 손잡이를 좌우로 움직여 비교해 보세요.</p>
    </div>

    {cases.length > 1 && (
      <div class="case-tabs reveal" role="tablist" aria-label="사례 선택">
        {cases.map((c, i) => (
          <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-case={i}>{c.area}</button>
        ))}
      </div>
    )}

    {cases.map((c, i) => (
      <div class="case reveal" data-case-panel={i} hidden={i !== 0}>
        {c.draft && <p class="draft-flag">시안 · 검토 중 — 내 컴퓨터 미리보기에서만 보이며 사이트에는 공개되지 않습니다</p>}
        <div class="ba" style="--pos:50%">
          <img class="ba-img" src={c.after} alt={`${c.area} 더셀젯 관리 후`} loading="lazy" />
          <div class="ba-before">
            <img class="ba-img" src={c.before} alt={`${c.area} 더셀젯 관리 전`} loading="lazy" />
          </div>
          <span class="ba-tag l">BEFORE</span>
          <span class="ba-tag r">AFTER</span>
          <div class="ba-line" aria-hidden="true"><span>◀ ▶</span></div>
          <input class="ba-range" type="range" min="0" max="100" value="50" aria-label={`${c.area} 관리 전후 비교 위치`} />
        </div>
        <dl class="ba-meta">
          <div><dt>관리 부위</dt><dd>{c.area}</dd></div>
          <div><dt>관리 횟수</dt><dd>{c.sessions}</dd></div>
          <div><dt>전 · 후 촬영 간격</dt><dd>{c.period}</dd></div>
          {c.ampoule && <div><dt>사용 앰플</dt><dd>{c.ampoule}</dd></div>}
          {c.mode && <div><dt>모드 · 강도</dt><dd>{c.mode}</dd></div>}
        </dl>
        {c.draft
          ? <p class="ba-note draft-note">검토 중인 사진입니다. 원본 · 보정 여부 · 촬영 정보 · 게재 동의를 확인한 뒤에만 공개됩니다.</p>
          : <p class="ba-note">본인 동의를 받아 게재한 실제 관리 사진이며, 사진은 보정하지 않았습니다. 관리 결과는 피부 상태와 관리 조건에 따라 개인차가 있습니다. (촬영 {c.shotDate}{c.place && ` · ${c.place}`})</p>}
      </div>
    ))}
  </div>
</section>
)}

<script>
  document.querySelectorAll<HTMLElement>('.ba').forEach((ba) => {
    const r = ba.querySelector<HTMLInputElement>('.ba-range')!;
    const set = () => ba.style.setProperty('--pos', r.value + '%');
    r.addEventListener('input', set);
    set();
  });
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.case-tabs [data-case]')];
  tabs.forEach((t) => t.addEventListener('click', () => {
    tabs.forEach((x) => x.setAttribute('aria-selected', String(x === t)));
    document.querySelectorAll<HTMLElement>('[data-case-panel]').forEach((p) => { p.hidden = p.dataset.casePanel !== t.dataset.case; });
  }));
</script>

<style>
  .draft-flag { margin-bottom: 10px; padding: 8px 14px; border-radius: 10px; background: #fff7ed; border: 1px dashed #f97316; color: #c2410c; font-weight: 800; font-size: 14px; text-align: center; }
  .case-tabs { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin-bottom: 24px; }
  .case-tabs button { padding: 10px 18px; border-radius: 999px; border: 1px solid #cbd5e1; background: #fff; font: inherit; font-weight: 800; font-size: 15px; color: var(--ink-2); cursor: pointer; }
  .case-tabs button[aria-selected=true] { background: var(--brand); border-color: var(--brand); color: #fff; }
  .case { max-width: 880px; margin: 0 auto; }
  .ba { position: relative; overflow: hidden; border-radius: 20px; background: #0f172a; box-shadow: 0 20px 50px rgba(15,23,42,.18); aspect-ratio: 4 / 3; touch-action: pan-y; }
  .ba-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .ba-before { position: absolute; inset: 0; clip-path: inset(0 calc(100% - var(--pos)) 0 0); }
  .ba-tag { position: absolute; top: 14px; z-index: 2; padding: 5px 11px; border-radius: 8px; background: rgba(10,15,29,.7); color: #fff; font: 800 12px var(--font-latin); letter-spacing: .1em; pointer-events: none; }
  .ba-tag.l { left: 14px; }
  .ba-tag.r { right: 14px; background: rgba(0,106,97,.85); }
  .ba-line { position: absolute; top: 0; bottom: 0; left: var(--pos); width: 3px; margin-left: -1.5px; background: #fff; z-index: 2; pointer-events: none; box-shadow: 0 0 12px rgba(0,0,0,.4); }
  .ba-line span { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 46px; height: 46px; border-radius: 50%; background: #fff; color: var(--brand); display: grid; place-items: center; font-size: 11px; letter-spacing: -1px; box-shadow: 0 4px 14px rgba(0,0,0,.3); }
  .ba-range { position: absolute; inset: 0; z-index: 3; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: ew-resize; }
  .ba:has(.ba-range:focus-visible) .ba-line span { outline: 3px solid var(--accent); }
  .ba-meta { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; margin: 18px 0 0; }
  .ba-meta div { padding: 12px 14px; border-radius: 12px; background: var(--bg-soft); border: 1px solid var(--line); }
  .ba-meta dt { font-size: 13px; color: var(--ink-3); font-weight: 700; }
  .ba-meta dd { margin: 2px 0 0; font-weight: 800; }
  .draft-note { color: #c2410c !important; font-weight: 700; }
  .ba-note { margin-top: 14px; font-size: 13.5px; color: var(--ink-3); }
</style>
